# Versiones del laboratorio.
# Por defecto, las vulnerables. El tramo de parcheo usa las *_PATCHED.

# PHP 8.3.35 es anterior a la corrección 8.3.36.
PHP_TAG=8.3.35-apache
PHP_TAG_PATCHED=8.3.36-apache

# Node 22.23.3 es anterior a la corrección 22.23.4.
NODE_TAG=22.23.3-bookworm-slim
NODE_TAG_PATCHED=22.23.4-bookworm-slim

# Brotli 1.0.9 es anterior a la corrección 1.2.1 (PyPI).
BROTLI_VERSION=1.0.9
BROTLI_VERSION_PATCHED=1.2.1
